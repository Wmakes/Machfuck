# Brainfuck-to-Mach source backend

use std.filesystem;
use std.io.error.Error;
use std.io.writer;
use std.io.writer.WriteError;
use std.types.error.err;
use std.types.path.Path;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use machfuck.program;

pub val OK:           u8 = 0;
pub val CREATE_ERROR: u8 = 1;
pub val WRITE_ERROR:  u8 = 2;
pub val CLOSE_ERROR:  u8 = 3;

val HEADER: str = "# Generated by Machfuck 1.0.0\n\nuse A: std.allocator;\nuse std.allocator.page;\nuse std.runtime;\nuse std.system.os;\nuse std.types.error.err;\nuse std.types.result.res;\nuse std.types.size.usize;\n\nval TAPE_SIZE: usize = 30000;\n\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i64 {\n    var allocator: A.Allocator;\n    val made: err[A.Error] = page.make(?allocator);\n    if (sel made.err) { ret 1; }\n    val allocated: res[*u8, A.Error] = A.zallocate[u8](?allocator, TAPE_SIZE);\n    if (sel allocated.err) { ret 1; }\n    val tape: *u8 = allocated.ok;\n    fin { A.deallocate[u8](?allocator, tape, TAPE_SIZE); }\n    var data_pointer: usize = 0;\n    var input_result: i64 = 0;\n";

val FOOTER: str = "    ret 0;\n}\n";

fun write_piece(w: *writer.Writer, text: str) u8 {
    val result: err[WriteError] = writer.write_str(w, text);
    if (sel result.err) { ret WRITE_ERROR; }
    ret OK;
}

fun emit_instruction(w: *writer.Writer, instruction: program.Instruction) u8 {
    if (instruction.operation == program.OP_RIGHT) {
        ret write_piece(w, "    if (data_pointer + 1 >= TAPE_SIZE) { ret 2; }\n    data_pointer = data_pointer + 1;\n");
    }
    if (instruction.operation == program.OP_LEFT) {
        ret write_piece(w, "    if (data_pointer == 0) { ret 2; }\n    data_pointer = data_pointer - 1;\n");
    }
    if (instruction.operation == program.OP_INCREMENT) {
        ret write_piece(w, "    if (tape[data_pointer] == 255) { tape[data_pointer] = 0; }\n    or { tape[data_pointer] = tape[data_pointer] + 1; }\n");
    }
    if (instruction.operation == program.OP_DECREMENT) {
        ret write_piece(w, "    if (tape[data_pointer] == 0) { tape[data_pointer] = 255; }\n    or { tape[data_pointer] = tape[data_pointer] - 1; }\n");
    }
    if (instruction.operation == program.OP_OUTPUT) {
        ret write_piece(w, "    if (os.write(os.stdout(), ?tape[data_pointer], 1) != 1) { ret 3; }\n");
    }
    if (instruction.operation == program.OP_INPUT) {
        ret write_piece(w, "    input_result = os.read(os.stdin(), ?tape[data_pointer], 1);\n    if (input_result < 0) { ret 3; }\n    if (input_result == 0) { tape[data_pointer] = 0; }\n");
    }
    if (instruction.operation == program.OP_LOOP_START) {
        ret write_piece(w, "    for (tape[data_pointer] != 0) {\n");
    }
    ret write_piece(w, "    }\n");
}

# Emit a complete Mach entry module. The caller can use it as src/main.mach in
# a project with mach-std 9.5.
pub fun emit(p: *program.Program, output: Path) u8 {
    val created: res[filesystem.File, Error] = filesystem.create(output, 420);
    if (sel created.err) { ret CREATE_ERROR; }
    var file: filesystem.File = created.ok;

    var w: writer.Writer = filesystem.writer(file);
    if (write_piece(?w, "# Machfuck-authored generated code may be used under terms of your choice.\n# See OUTPUT-PERMISSION.md in the Machfuck distribution.\n") != OK) {
        filesystem.close(?file);
        ret WRITE_ERROR;
    }
    if (write_piece(?w, HEADER) != OK) {
        filesystem.close(?file);
        ret WRITE_ERROR;
    }

    var i: usize = 0;
    for (i < p.instructions.len) {
        if (emit_instruction(?w, p.instructions.data[i]) != OK) {
            filesystem.close(?file);
            ret WRITE_ERROR;
        }
        i = i + 1;
    }
    if (write_piece(?w, FOOTER) != OK) {
        filesystem.close(?file);
        ret WRITE_ERROR;
    }
    val closed: err[Error] = filesystem.close(?file);
    if (sel closed.err) { ret CLOSE_ERROR; }
    ret OK;
}
